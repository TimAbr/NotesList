<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.NotesList" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_on_primary_container</item>

        <item name="colorSecondary">@color/theme_secondary</item>
        <item name="colorOnSecondary">@color/theme_on_secondary</item>
        <item name="colorSecondaryContainer">@color/theme_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_on_secondary_container</item>

        <item name="android:colorBackground">@color/theme_background</item>
        <item name="colorOnBackground">@color/theme_on_background</item>
        <item name="colorSurface">@color/theme_surface</item>
        <item name="colorOnSurface">@color/theme_on_surface</item>

        <item name="colorSurfaceVariant">@color/theme_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/theme_on_surface_variant</item>

        <item name="colorOutline">@color/theme_outline</item>

        <item name="colorError">@color/theme_error</item>
        <item name="colorOnError">@color/theme_on_error</item>
    </style>

    <style name="Theme.NotesList" parent="Base.Theme.NotesList" />

    <style name="ShapeAppearance.App.Slider.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.App.Slider" parent="Widget.Material3.Slider">
        <item name="tickColorActive">?attr/colorOnSurfaceVariant</item>
        <item name="tickColorInactive">?attr/colorOutline</item>

        <item name="trackHeight">16dp</item>

        <item name="thumbRadius">14dp</item>
        <item name="thumbWidth">28dp</item>
        <item name="thumbHeight">28dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Slider.Thumb</item>
        <item name="thumbColor">?attr/colorPrimary</item>

        <item name="thumbTrackGapSize">0dp</item>

        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorSurfaceVariant</item>

        <item name="haloRadius">0dp</item>

        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

</resources>