<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/notesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipToPadding="false">

        <com.example.noteslist.presentation.notes_list.views.note.NoteView
            style="@style/NoteStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:noteTitle="Простая заметка"
            app:noteBody="Это обычная непрочитанная заметка с дефолтными стилями."
            app:noteDate="25.05.2024 10:00" />

        <com.example.noteslist.presentation.notes_list.views.note.NoteView
            style="@style/NoteStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:isImportant="true"
            app:noteBody="Тут должна появиться иконка звезды, а заголовок должен немного сместиться вправо."
            app:noteDate="25.05.2024 12:30"
            app:noteTitle="Очень важное дело" />

        <com.example.noteslist.presentation.notes_list.views.note.NoteView
            style="@style/NoteStyle.Read"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:noteBody="Здесь фон заголовка и тела должен стать одинаковым, а внизу появиться галочка."
            app:noteDate="20.05.2024 18:45"
            app:noteTitle="Прочитанная заметка" />

        <com.example.noteslist.presentation.notes_list.views.note.NoteView
            style="@style/NoteStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:noteTitle="Тест градиента (Fade)"
            app:noteBody="Этот текст специально сделан очень длинным, чтобы он не поместился в две строки. Мы проверяем, работает ли ограничение MAX_BODY_LINES и плавно ли обрезается текст с помощью нашего LinearGradient в конце второй строки. Проверка, проверка, проверка!"
            app:noteDate="24.05.2024 09:15" />

        <com.example.noteslist.presentation.notes_list.views.note.NoteView
            style="@style/NoteStyle.Read"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:isImportant="true"
            app:noteTitle="Важное, но прочитанное"
            app:noteBody="Сочетание звезды в заголовке и галочки в футере на сером фоне."
            app:noteDate="22.05.2024 15:00" />

        <com.example.noteslist.presentation.notes_list.views.note.NoteView
            style="@style/NoteStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:noteHeaderColor="#FFEB3B"
            app:noteBackgroundColor="#FFF9C4"
            app:noteTitleColor="#000000"
            app:noteTitle="Кастомные цвета"
            android:padding="5dp"
            app:noteBody="Тут мы переопределили цвета и паддинги прямо в теге, не меняя стиль."
            app:noteDate="25.05.2024 23:59" />

    </LinearLayout>
</ScrollView>