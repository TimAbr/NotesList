<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/notesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1) Пустой стек (EmptyView)"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <com.example.noteslist.presentation.notes_list.views.notes_stack.NoteStackView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:padding="16dp"
            app:stackSpacing="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2) Один элемент (без эффекта стека)"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <com.example.noteslist.presentation.notes_list.views.notes_stack.NoteStackView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:stackSpacing="10dp">

            <com.example.noteslist.presentation.notes_list.views.note.NoteView
                style="@style/NoteStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:noteTitle="Одиночная заметка"
                app:noteBody="Когда элемент один, стек не должен добавлять смещения."
                app:noteDate="25.05.2024 10:00" />
        </com.example.noteslist.presentation.notes_list.views.notes_stack.NoteStackView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3) Два элемента (стек шире)"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <com.example.noteslist.presentation.notes_list.views.notes_stack.NoteStackView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:stackSpacing="20dp">

            <com.example.noteslist.presentation.notes_list.views.note.NoteView
                style="@style/NoteStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:noteTitle="Заметка сверху (2)"
                app:noteBody="Этот элемент должен быть шире, чем в следующем примере."
                app:noteDate="25.05.2024 11:00" />

            <com.example.noteslist.presentation.notes_list.views.note.NoteView
                style="@style/NoteStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:noteTitle="Заметка снизу"
                app:noteDate="25.05.2024 10:30" />
        </com.example.noteslist.presentation.notes_list.views.notes_stack.NoteStackView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4) Четыре элемента (стек уже, максимум 3 видимых)"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <com.example.noteslist.presentation.notes_list.views.notes_stack.NoteStackView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:stackSpacing="20dp"
            app:stackMaxVisible="3">

            <com.example.noteslist.presentation.notes_list.views.note.NoteView
                style="@style/NoteStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:noteTitle="Верхняя заметка (4)"
                app:noteBody="Здесь смещение больше, поэтому ширина контента меньше."
                app:noteDate="25.05.2024 14:00" />

            <com.example.noteslist.presentation.notes_list.views.note.NoteView
                style="@style/NoteStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:noteTitle="Вторая заметка"
                app:noteDate="25.05.2024 13:00" />

            <com.example.noteslist.presentation.notes_list.views.note.NoteView
                style="@style/NoteStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:noteTitle="Третья заметка"
                app:noteDate="25.05.2024 12:00" />

            <com.example.noteslist.presentation.notes_list.views.note.NoteView
                style="@style/NoteStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:noteTitle="Четвертая (скрыта в стеке)"
                app:noteDate="25.05.2024 11:00" />
        </com.example.noteslist.presentation.notes_list.views.notes_stack.NoteStackView>

    </LinearLayout>
</ScrollView>