<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/notesListFragment">

    <action
        android:id="@+id/action_global_noteDetailsFragment"
        app:destination="@id/noteDetailsFragment" />

    <fragment
        android:id="@+id/notesListFragment"
        android:name="com.example.noteslist.presentation.notes_list.NotesListFragment"
        android:label="NotesListFragment" />

    <fragment
        android:id="@+id/noteDetailsFragment"
        android:name="com.example.noteslist.presentation.note_details.NoteDetailsFragment"
        android:label="NoteDetailsFragment">
        <argument
            android:name="mode"
            app:argType="com.example.noteslist.presentation.note_details.NoteDetailsScreenMode" />
    </fragment>

    <fragment
        android:id="@+id/emptyFragment"
        android:name="com.example.noteslist.presentation.note_details.NoteDetailsPlaceholderFragment"
        android:label="EmptyFragment" />

    <dialog
        android:id="@+id/settingsBottomSheet"
        android:name="com.example.noteslist.presentation.settings.SettingsBottomSheetFragment"
        android:label="SettingsBottomSheetFragment"
        tools:layout="@layout/fragment_settings_bottom_sheet" />

</navigation>
